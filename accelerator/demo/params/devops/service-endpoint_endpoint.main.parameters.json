                    }
                },
                {
                    "name": "rg-{prefix}-portugal-{uniqueId}-prd-weu",
                    "description": "Service Connection for Managed Identity 'id-{prefix}-portugal-{uniqueId}-prd' to access resources in subscription '{subscriptionId}'",
                    "managedIdentity": {
                        "name": "id-{prefix}-portugal-{uniqueId}-prd",
                        "subscriptionId": "{subscriptionId}",
                        "resourceGroupName": "rg-{prefix}-portugal-{uniqueId}-prd-weu",
                        "federatedIdentityCredential": {
                            "name": "fic-{prefix}-portugal-{uniqueId}-prd"
                        }
                    }
                }
            ]
        }
    ]
