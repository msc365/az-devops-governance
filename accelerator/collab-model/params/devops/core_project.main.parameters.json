{
    "$schema": "../../../../schemas/project.schema.json",
    "collectionUri": "{collectionUri}",
    "projects": [
        {
            "name": "{prefix}-{service}",
            "description": "Demo - 1 project, many teams, many repos, pipelines and artifacts.",
            "defaultTeam": "{service} Team",
            "sourceControl": "Git",
            "process": "Agile",
            "features": {
                "boards": "enabled",
                "repos": "enabled",
                "pipelines": "enabled",
                "artifacts": "enabled",
                "testPlans": "disabled"
            },
            "visibility": "Private"
        }
    ]
}
