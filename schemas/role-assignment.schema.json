{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/msc365/az-devops-governance/main/schemas/role-assignment.schema.json",
    "title": "Role Assignment Schema",
    "description": "Schema for role assignment configuration",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "description": "JSON Schema reference"
        },
        "objectId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "The object ID of the principal (user, group, or service principal) - must be a valid GUID"
        },
        "roleAssignments": {
            "type": "array",
            "description": "Array of role assignments to apply",
            "items": {
                "type": "object",
                "required": [
                    "roleDefinitionName",
                    "scope"
                ],
                "properties": {
                    "roleDefinitionName": {
                        "type": "string",
                        "description": "The name of the Azure role definition (e.g., Reader, Contributor, Owner)"
                    },
                    "scope": {
                        "type": "string",
                        "description": "The scope at which the role assignment applies (e.g., subscription, resource group, or resource)"
                    }
                },
                "additionalProperties": false
            },
            "minItems": 1
        },
        "enforce": {
            "type": "boolean",
            "description": "Whether to enforce the desired state by removing any role assignments not defined in the configuration",
            "default": false
        }
    },
    "required": [
        "objectId",
        "roleAssignments"
    ],
    "additionalProperties": false
}
