{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/msc365/az-devops-governance/main/schemas/config.schema.json",
    "title": "Configuration Schema",
    "description": "Schema for main configuration file",
    "type": "object",
    "required": [
        "uniqueId",
        "prefix",
        "service",
        "location",
        "collectionUri"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Reference to the JSON schema"
        },
        "uniqueId": {
            "type": "string",
            "pattern": "^(?:[a-z0-9]{3,10})?$",
            "maxLength": 10,
            "description": "The lowercase unique identifier (3-10 alphanumeric characters, or empty)"
        },
        "prefix": {
            "type": "string",
            "pattern": "^[a-z0-9]{2,10}$",
            "maxLength": 10,
            "description": "A lowercase prefix to be used in resource names (max 10 alphanumeric characters)"
        },
        "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-zA-Z0-9]{2,20}$",
            "description": "A service name to be used in resource names (2-20 alphanumeric characters)"
        },
        "location": {
            "type": "string",
            "description": "The Azure location for resource deployment"
        },
        "subscriptionId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "Optional Azure subscription identifier (GUID)"
        },
        "collectionUri": {
            "type": "string",
            "description": "The Azure DevOps collection URI"
        }
    },
    "additionalProperties": false
}
