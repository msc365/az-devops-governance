{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/msc365/az-devops-governance/main/schemas/config.schema.json",
    "title": "Configuration Schema",
    "description": "Schema for main configuration file",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Reference to the JSON schema"
        },
        "uniqueId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9]{6}$|^$",
            "maxLength": 6,
            "description": "Unique identifier (6 lowercase alphanumeric characters, or empty)"
        },
        "prefix": {
            "type": "string",
            "pattern": "^[a-z0-9]{1,10}$",
            "maxLength": 10,
            "description": "Prefix to be used in resource names (max 10 lowercase alphanumeric characters)"
        },
        "organization": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{2,62}$",
            "maxLength": 63,
            "description": "Azure DevOps organization name"
        }
    },
    "required": [
        "uniqueId",
        "prefix",
        "organization"
    ],
    "additionalProperties": false
}
