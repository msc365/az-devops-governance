{
	"Baseline PowerShell Function": {
		"scope": "powershell",
		"prefix": "baseline-posh-function",
		"description": "A sample function that's aligned to baseline coding guidelines.",
		"body": [
			"function ${0:Verb-Noun} {",
			"    <#",
			"    .SYNOPSIS",
			"",
			"    .DESCRIPTION",
			"",
			"    .PARAMETER ProjectName",
			"         Optional. The Azure DevOps project Name or ID.",
			"",
			"    .PARAMETER CollectionUri",
			"         Optional. The Azure DevOps collection URI.",
			"",
			"    .OUTPUTS",
			"",
			"    .EXAMPLE",
			"",
			"    #>",
			"    [CmdletBinding(SupportsShouldProcess)]",
			"    [OutputType([PSCustomObject])]",
			"    param (",
			"        [Parameter()]",
			"        [string]\\$CollectionUri = \\$env:DefaultAdoCollectionUri,",
			"",
			"        [Parameter()]",
			"        [string]\\$ProjectName = \\$env:DefaultAdoProjectName",
			"    )",
			"",
			"    begin {",
			"        Write-Verbose (\"[Enter]: ./\\\$(\\$MyInvocation.MyCommand.Name)\")",
			"    }",
			"",
			"    process {",
			"        try {",
			"            \\$ErrorActionPreference = 'Stop'",
			"",
			"            #region INITIALIZE",
			"",
			"            #endregion",
			"",
			"            #region DEPLOYMENTS",
			"",
			"            if (\\$PSCmdlet.ShouldProcess(\"Project: \\$ProjectName\",)) {}",
			"",
			"            #endregion",
			"",
			"            #region ROLLBACK",
			"",
			"            #endregion",
			"",
			"            #region OUTPUTS",
			"",
			"            # Direct output of PSCustomObject",
			"            [PSCustomObject]@{",
			"                projectName = \\$ProjectName",
			"                status      = 'NotImplemented'",
			"            }",
			"",
			"            #endregion",
			"",
			"        } catch {",
			"            throw \\$_",
			"        }",
			"    }",
			"",
			"    end {",
			"        Write-Verbose (\"[Exit]: ./\\\$(\\$MyInvocation.MyCommand.Name)\")",
			"    }",
			"}"
		]
	},
	"Baseline PowerShell Parameter": {
		"scope": "powershell",
		"prefix": "baseline-posh-parameter",
		"description": "A sample parameter that's aligned to baseline coding guidelines.",
		"body": [
			"[Parameter()]",
			"[string]\\$ParamName = ''"
		]
	}
}
